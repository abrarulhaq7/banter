/**
 * Writes the SQL that copies the default prompts from the app's code into Supabase.
 *
 *   npm run db:prompts
 *   then paste supabase/paste-prompts.sql into Supabase > SQL Editor and press Run.
 *
 * Safe to run again: it updates what is there. Run it after changing
 * src/engine/default-prompts.ts, so the database and the app say the same thing.
 */
import { writeFileSync } from 'node:fs';
import { resolve } from 'node:path';

import { DEFAULT_CORE, DEFAULT_MODES, DEFAULT_TONES } from '../src/engine/default-prompts';

const TAG = '$banter$';

function quote(text: string): string {
  if (text.includes(TAG)) throw new Error(`A prompt contains ${TAG}, which this script uses as a marker.`);
  return `${TAG}${text}${TAG}`;
}

const modes = Object.entries(DEFAULT_MODES)
  .map(([id, mode], index) => `  ('${id}', ${quote(mode.label)}, ${index + 1}, ${quote(mode.instruction)})`)
  .join(',\n');

const tones = Object.entries(DEFAULT_TONES)
  .map(([id, tone], index) => `  ('${id}', ${quote(tone.label)}, ${index + 1}, ${quote(tone.definition)})`)
  .join(',\n');

const sql = `-- Banter default prompts. Generated by scripts/prompts-sql.mts from
-- src/engine/default-prompts.ts; do not edit. Safe to run more than once.

begin;

-- Core rules and answer format, version ${DEFAULT_CORE.version}. Only one version is active.
update public.prompt_core set is_active = false where is_active and version <> ${DEFAULT_CORE.version};

insert into public.prompt_core (version, is_active, notes, rules, output_format)
values (
  ${DEFAULT_CORE.version},
  true,
  'Synced from src/engine/default-prompts.ts',
  ${quote(DEFAULT_CORE.rules)},
  ${quote(DEFAULT_CORE.outputFormat)}
)
on conflict (version) do update
  set is_active = true,
      notes = excluded.notes,
      rules = excluded.rules,
      output_format = excluded.output_format;

insert into public.modes (id, label, sort_order, instruction)
values
${modes}
on conflict (id) do update
  set label = excluded.label,
      sort_order = excluded.sort_order,
      instruction = excluded.instruction;

insert into public.tones (id, label, sort_order, definition)
values
${tones}
on conflict (id) do update
  set label = excluded.label,
      sort_order = excluded.sort_order,
      definition = excluded.definition;

commit;
`;

const out = resolve(import.meta.dirname, '..', 'supabase', 'paste-prompts.sql');
writeFileSync(out, sql);
console.log(`Wrote supabase/paste-prompts.sql (prompt version ${DEFAULT_CORE.version}, ${sql.split('\n').length} lines)`);
