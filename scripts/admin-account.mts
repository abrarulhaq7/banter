/**
 * Makes the account that reads and resolves feedback tickets, once.
 *
 *   npm run admin:setup
 *
 * Signs up a new account with a random password, saves its login in
 * admin-account.local.json (not in git), and writes supabase/paste-admin.sql: paste that into
 * the Supabase SQL editor to make the account an admin. Run again to get the SQL again.
 */
import { createClient } from '@supabase/supabase-js';
import { randomBytes } from 'node:crypto';
import { existsSync, readFileSync, writeFileSync } from 'node:fs';
import { join, resolve } from 'node:path';

const root = resolve(import.meta.dirname, '..');
const accountPath = join(root, 'admin-account.local.json');

function fail(message: string): never {
  console.error(`\n${message}\n`);
  process.exit(2);
}

const env = Object.fromEntries(
  readFileSync(join(root, '.env.local'), 'utf8')
    .split('\n')
    .filter((line) => line.includes('=') && !line.trim().startsWith('#'))
    .map((line) => {
      const at = line.indexOf('=');
      return [line.slice(0, at).trim(), line.slice(at + 1).trim().replace(/^["']|["']$/g, '')];
    }),
);
const url = env.EXPO_PUBLIC_SUPABASE_URL;
const key = env.EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY;
if (!url || !key) fail('.env.local is missing the Supabase address or publishable key.');
const supabase = createClient(url, key, { auth: { persistSession: false } });

let account: { email: string; password: string };
if (existsSync(accountPath)) {
  account = JSON.parse(readFileSync(accountPath, 'utf8'));
  console.log(`Using the admin account in admin-account.local.json (${account.email}).`);
} else {
  account = { email: 'banter.admin@example.com', password: `admin-${randomBytes(9).toString('base64url')}` };
  const signedUp = await supabase.auth.signUp(account);
  if (signedUp.error) fail(`Could not make the admin account: ${signedUp.error.message}`);
  writeFileSync(accountPath, `${JSON.stringify({ ...account, note: 'Reads and resolves feedback tickets. Never commit.' }, null, 2)}\n`);
  console.log(`Made ${account.email}; its login is in admin-account.local.json.`);
}

const signedIn = await supabase.auth.signInWithPassword(account);
if (signedIn.error || !signedIn.data.user) fail(`Could not sign in: ${signedIn.error?.message}`);
const userId = signedIn.data.user.id;
await supabase.auth.signOut();

const sql = `-- Makes ${account.email} an admin: it can read and resolve every feedback ticket.
-- Generated by scripts/admin-account.mts. Safe to run more than once.
insert into public.admins (user_id) values ('${userId}') on conflict (user_id) do nothing;
`;
writeFileSync(join(root, 'supabase', 'paste-admin.sql'), sql);
console.log('Wrote supabase/paste-admin.sql. Paste it into the Supabase SQL editor once.');
